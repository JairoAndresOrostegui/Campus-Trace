rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAdmin() {
      return signedIn() &&
        userData().status == 'activo' &&
        userData().role == 'Administrador';
    }

    function canManageUser(userId) {
      let caller = userData();
      let target = firestore.get(
        /databases/(default)/documents/users/$(userId)
      ).data;
      return signedIn() &&
        caller.status == 'activo' &&
        caller.role == 'Docente' &&
        caller.get('permissions', []).hasAny(['usuarios.editar']) &&
        target.role != 'Administrador';
    }

    match /fotos_perfil/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() || canManageUser(userId) ||
        (signedIn() && request.auth.uid == userId);
    }

    match /{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
