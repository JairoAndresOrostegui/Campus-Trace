AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=nam5
DEFAULT_FROM=Soporte <soporte@desarrolloytecnologiasantander.com>
DEFAULT_REPLY_TO=Contacto <contacto@desarrolloytecnologiasantander.com>
firebaseextensions.v1beta.function/location=us-central1
firebaseextensions.v1beta.function/minInstances=0
firebaseextensions.v1beta.function/vpcConnectorEgressSettings=VPC_CONNECTOR_EGRESS_SETTINGS_UNSPECIFIED
firebaseextensions.v1beta.v2function/memory=256Mi
MAIL_COLLECTION=mail
OAUTH_PORT=465
OAUTH_SECURE=false
SMTP_CONNECTION_URI=smtps://soporte%40desarrolloytecnologiasantander.com@smtp.hostinger.com:465
SMTP_PASSWORD=projects/${param:PROJECT_NUMBER}/secrets/firestore-send-email-s603-SMTP_PASSWORD/versions/latest
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1